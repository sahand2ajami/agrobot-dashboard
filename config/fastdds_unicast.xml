<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="rtps_participant_profile" is_default_profile="true">
    <rtps>
      <builtin>
        <initialPeersList>
          <!-- Operator laptop on TP-Link local network -->
          <locator>
            <udpv4>
              <address>192.168.0.225</address>
            </udpv4>
          </locator>
          <!-- localhost — required for same-machine node discovery when
               a custom initialPeersList overrides FastDDS defaults -->
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
