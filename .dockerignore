# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── ROS 2 build artifacts (rebuilt inside the container) ─────────────────────
build/
install/
log/

# ── Runtime / volatile data ───────────────────────────────────────────────────
logs/
/tmp/

# ── Reference clones (read-only; not needed in the image) ────────────────────
reference/

# ── Development / editor files ───────────────────────────────────────────────
.env
.env.*
*.swp
*.swo
.vscode/
.idea/

# ── Developer docs / reports (not needed at runtime) ─────────────────────────
# NOTE: docs/ is intentionally included — the optional PLC symbol-table CSV
# is read at runtime by the /api/plc/tags endpoint.
documents/
*.md
