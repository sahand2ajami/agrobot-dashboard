<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>avatar_robot_base</name>
  <version>0.0.0</version>
  <description>Agrobot chassis base: Modbus RTU driver, dead-reckoning odometry,
  path trace and keyboard teleop for the T3/T13/T17E variants</description>
  <maintainer email="sahand.ajami@gmail.com">Agrobot</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
